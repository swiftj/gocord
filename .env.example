# discord-mcp configuration — copy to .env and fill in. Never commit .env.
# Precedence: flag > env > config file > default.

# Bot token from the Discord Developer Portal (Bot → Reset Token). Never logged.
DISCORD_BOT_TOKEN=

# Optional JSON file defining named profiles; profiles reference tokens via
# "token_env" (an env var name), never inline tokens.
DISCORD_MCP_CONFIG=

# Active profile at startup.
DISCORD_MCP_PROFILE=default

# Transport: stdio (Claude Desktop/Code) or http (Streamable HTTP on /mcp).
DISCORD_MCP_TRANSPORT=stdio

# HTTP listen address (http transport only). Loopback by default; put auth in
# front of it before exposing it beyond localhost.
DISCORD_MCP_HTTP_ADDR=127.0.0.1:8080

# Search index location: :memory: (RAM only) or a file path, e.g.
# ~/.config/discord-mcp/index.db (created with 0600 permissions).
DISCORD_MCP_DB_PATH=:memory:

# Block all write and destructive tools (dry runs remain allowed).
DISCORD_MCP_READ_ONLY=false

# Guild used when a tool omits guild_id.
DISCORD_MCP_DEFAULT_GUILD_ID=

# Log level (logs go to stderr only): debug, info, warn, error.
DISCORD_MCP_LOG_LEVEL=info

# Optional: Discord webhook URL used by the Claude plugin's lifecycle hook
# (ecosystem/claude-plugin/scripts/notify-discord.sh). Leave empty to disable.
DISCORD_MCP_NOTIFY_WEBHOOK_URL=
